{
  "name": "nested-todos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host",
    "typecheck": "tsc -b",
